ANTHROPIC_API_KEY=your-anthropic-key-here
NEWSAPI_KEY=your-newsapi-key-here
GITHUB_TOKEN=your-github-token-here
OUTPUT_DIR=./output
# Per-request HTTP timeout in seconds (optional, default 10)
REQUEST_TIMEOUT=10
# Freshness window for `--cache`, in seconds (optional, default 3600)
CACHE_TTL=3600
# Claude model used for the narrative (optional)
ANTHROPIC_MODEL=claude-sonnet-4-6
# Token budget for the narrative (optional, default 1024)
MAX_TOKENS=1024
# arXiv category the arxiv agent tracks (optional, default cs.AI)
ARXIV_CATEGORY=cs.AI
