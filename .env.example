# LLM provider for the narrative: "anthropic" (default, needs ANTHROPIC_API_KEY)
# or "github" (free tier via GitHub Models, needs GITHUB_TOKEN)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your-anthropic-key-here
NEWSAPI_KEY=your-newsapi-key-here
GITHUB_TOKEN=your-github-token-here
OUTPUT_DIR=./output
# Per-request HTTP timeout in seconds (optional, default 10)
REQUEST_TIMEOUT=10
